programa
{
	
	funcao inicio()
	{
		 inteiro numero 
          inteiro maior
        
          
         escreva("fale um numero : ")
	     leia(numero)

            maior = numero
	     
		  para(inteiro i=1; i <= 4; i++)
		  {

             escreva("fale um numero : ")
	     leia(numero)

	     se (numero > maior){
	     	maior = numero
	     }

	     
		  	
		  }
             escreva("o maior numero é ", maior)
	}
}
